
############################################################
# AREON - ProjectRedDust
# Unreal Engine 5 Git Ignore
############################################################

############################
# UNREAL ENGINE GENERATED FOLDERS
############################

# Build outputs and compiled binaries
**/Binaries/

# Temporary build and shader files
**/Intermediate/

# Derived asset and shader cache
**/DerivedDataCache/

# Autosaves, logs, crash reports and local editor data
**/Saved/

############################
# PLUGIN GENERATED FILES
############################

**/Plugins/**/Binaries/
**/Plugins/**/Intermediate/

############################
# IDE AND EDITOR FILES
############################

# Visual Studio
**/.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.VC.VC.opendb

# JetBrains Rider
**/.idea/
*.sln.DotSettings.user

# VS Code (local workspace files)
**/.vscode/
*.code-workspace

# Xcode
*.xcodeproj/
*.xcworkspace/
*.xcuserstate
*.xcuserdata/

############################
# GENERATED BUILD DATA
############################

# Generated map build data
**/*_BuiltData.uasset

# Debug symbols and compiler intermediates
*.pdb
*.ilk
*.exp
*.obj
*.o
*.slo
*.lo
*.pch
*.gch

############################
# LOGS AND TEMPORARY FILES
############################

*.log
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~

# Crash dumps
*.dmp
*.stackdump

############################
# OPERATING SYSTEM FILES
############################

.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

############################################################
# IMPORTANT:
# DO NOT IGNORE Content, Config, Source, Plugins,
# .uproject, .uplugin, or required Build scripts.
############################################################
